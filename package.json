{
  "name": "standard-tool",
  "version": "0.1.0",
  "description": "Reference implementation of StandardToolV0 — one type for an LLM tool, portable across providers, SDKs, and frameworks. Zero dependencies, built on Standard Schema.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "WHY.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:site": "node scripts/build-site.mjs",
    "prepare": "tsc",
    "typecheck": "tsc -p test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "npm run build && npm run typecheck && npm run lint && node --test",
    "patch": "npm test && npm version patch",
    "minor": "npm test && npm version minor",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "standard-schema",
    "standard-json-schema",
    "json-schema",
    "llm",
    "tool",
    "function-calling",
    "openai",
    "mcp",
    "validation",
    "zod",
    "valibot",
    "arktype"
  ],
  "author": "Andrey Gubanov",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/standard-tool.git"
  },
  "homepage": "https://github.com/finom/standard-tool#readme",
  "bugs": {
    "url": "https://github.com/finom/standard-tool/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@orpc/server": "^1.15.0",
    "@trpc/server": "^11.18.0",
    "@types/node": "^26.4.1",
    "@valibot/to-json-schema": "^1.7.1",
    "arktype": "^2.2.3",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "zod": "^4.5.4"
  }
}
